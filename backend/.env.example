# Database
DATABASE_URL=postgresql+asyncpg://ged_user:ged_password_secure_local@ged-saas-project-db-1:5432/ged_saas_db

# Papel de banco POR CONSUMIDOR (SEC-RLS-00B / ADR-016 §9.1).
#
# `DATABASE_URL` acima aponta para `ged_user`, que é SUPERUSER e BYPASSRLS —
# achado F-12: a RLS está inerte no runtime. As três variáveis abaixo existem
# para trocar isso UM CONSUMIDOR DE CADA VEZ, e ficam VAZIAS de propósito
# enquanto o gate `SEC-RLS-ROLLOUT` não acontece: vazia = cai em
# `DATABASE_URL`, isto é, comportamento idêntico ao de hoje.
#
# Promover um degrau é definir a variável; o rollback é apagá-la e reiniciar o
# serviço — sem redeploy de código.
#
# ORDEM: worker, depois app. MIGRATOR_DATABASE_URL fica por ÚLTIMO e HOJE ESTÁ
# BLOQUEADA — não a defina em homologação nem em produção.
#
# Por quê: `aprimora_migrator` tem CREATE nos schemas mas NÃO é dono das
# tabelas legadas (o dump de scripts/bootstrap-db.sh é carregado por
# `ged_user`), e `ALTER TABLE`/`CREATE POLICY` em tabela pré-existente exigem
# posse. Como `sync_database_url` deriva desta variável e o `entrypoint.sh`
# roda `alembic upgrade head` com `set -e`, defini-la e depois mergear uma
# migration com `ADD COLUMN` em `utils.*` faz o backend MORRER NO START com
# `must be owner of table` — chega como indisponibilidade, não como erro de
# permissão previsto. Ela só é segura para CLI de seed/backup, invocada à mão
# com a variável no comando. Desbloqueia quando a posse dos schemas for
# resolvida no bootstrap.
#
# APP_DATABASE_URL=postgresql+asyncpg://aprimora_app:ged_password_secure_local@ged-saas-project-db-1:5432/ged_saas_db
# WORKER_DATABASE_URL=postgresql+asyncpg://aprimora_worker:ged_password_secure_local@ged-saas-project-db-1:5432/ged_saas_db
# MIGRATOR_DATABASE_URL=postgresql+asyncpg://aprimora_migrator:ged_password_secure_local@ged-saas-project-db-1:5432/ged_saas_db

# JWT
JWT_SECRET_SOURCE=db
JWT_ALGORITHM=HS256

# App
ENVIRONMENT=desenvolvimento
ALLOWED_ORIGINS=http://localhost:8090,http://localhost:3000,http://localhost:3100

# Storage
UPLOADS_DIR=/app/uploads/anexos
TENANTS_STORAGE_ROOT=/app/uploads/tenants

# Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Multi-tenant
BASE_DOMAIN=aprimora.local
DEFAULT_TENANT_SLUG=sobral

# Encryption (dev key - não usar em produção!)
DADOS_SENSIVEIS_ENCRYPTION_KEY=W4Y0YOLUBx1KvNRIV2FqPJN9RNmR5PZlP3y4Lx9gk4M=

# Fronteira de plataforma (SEC-01A / ADR-016)
#
# `PLATFORM_ADMIN_EMAILS` FOI REMOVIDA. Era o achado F-01: autorização
# cross-tenant por um e-mail que só é único POR TENANT. Se ainda existir no
# `.env` de algum host, apague — enquanto existir num ambiente continua sendo um
# caminho ativo, mesmo que o código já a ignore.
#
# Nenhuma variável abaixo tem default: ausente ⇒ a fronteira NEGA tudo e a
# inicialização registra erro. Um default embutido converteria esquecimento de
# configuração em porta aberta.
#
# Um OAuth client DEDICADO por ambiente — nunca o mesmo de dev/homolog/prod, e
# nunca o client da integração Google Docs acima. Client secret vai para o
# cofre/host, jamais para o repositório.
# Procedimento completo: docs/runbooks/platform-operator-bootstrap.md
#PLATFORM_OIDC_ISSUER=https://accounts.google.com
#PLATFORM_OIDC_AUDIENCE=SEU_CLIENT_ID_DO_CONSOLE.apps.googleusercontent.com
#PLATFORM_OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
#PLATFORM_OIDC_HOSTED_DOMAIN=SEU_DOMINIO_CORPORATIVO
# Conexão dedicada, papel `aprimora_platform` (NOBYPASSRLS, criado pela
# migration 0076). NUNCA apontar para `ged_user` nem reusar DATABASE_URL.
#PLATFORM_DB_URL=postgresql+asyncpg://aprimora_platform:ged_password_secure_local@db:5432/ged_saas_db

# Google Docs OAuth (Phase 4-5)
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8090/api/v2/auth/google/callback
GOOGLE_CREDENTIALS_FILE=/app/keys/google-credentials.json
