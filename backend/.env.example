# Database
DATABASE_URL=postgresql+asyncpg://ged_user:ged_password_secure_local@ged-saas-project-db-1:5432/ged_saas_db

# JWT
JWT_SECRET_SOURCE=db
JWT_ALGORITHM=HS256

# App
ENVIRONMENT=desenvolvimento
ALLOWED_ORIGINS=http://localhost:8090,http://localhost:3000,http://localhost:3100

# Storage
UPLOADS_DIR=/app/uploads/anexos
TENANTS_STORAGE_ROOT=/app/uploads/tenants

# Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Multi-tenant
BASE_DOMAIN=aprimora.local
DEFAULT_TENANT_SLUG=sobral

# Encryption (dev key - não usar em produção!)
DADOS_SENSIVEIS_ENCRYPTION_KEY=W4Y0YOLUBx1KvNRIV2FqPJN9RNmR5PZlP3y4Lx9gk4M=

# Google Docs OAuth (Phase 4-5)
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v2/auth/google/callback
GOOGLE_CREDENTIALS_FILE=/app/keys/google-credentials.json
